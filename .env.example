# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:2008@localhost:5433/myagent"

# Optional: Ollama local models
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Cloud model API keys are named from the model registry.
# Example:
# MYAGENT_ANTHROPIC_CLAUDE_OPUS_4_6_API_KEY=
# MYAGENT_OPENAI_GPT_5_4_API_KEY=
# MYAGENT_GOOGLE_GEMINI_3_PRO_API_KEY=

# Local API authentication and sandbox (optional; see docs/SEGURANCA_E_TESTES.md)
# Token is generated automatically in the user's private ~/.myagent directory.
# MYAGENT_API_TOKEN=use-at-least-32-random-alphanumeric-characters
# MYAGENT_CONFIG_DIR=C:/Users/you/.myagent
# MYAGENT_WORKSPACE_ROOTS=["C:/projects"]
# MYAGENT_SANDBOX_IMAGE=alpine:3
# MYAGENT_TEST_DOCKER_IMAGE=alpine:3
