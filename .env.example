# SQLite local: ~/.myagent/myagent.db (DATABASE_URL não é necessário).
# MYAGENT_HOME=C:/Users/voce/.myagent

# Ollama local (também pode ser salvo em ~/.myagent/config.env).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Cloud model API keys are named from the model registry.
# Example:
# MYAGENT_ANTHROPIC_CLAUDE_OPUS_4_6_API_KEY=
# MYAGENT_OPENAI_GPT_5_4_API_KEY=
# MYAGENT_GOOGLE_GEMINI_3_PRO_API_KEY=

# Desenvolvimento: token privado persistido; o launcher usa token aleatório por execução.
# MYAGENT_API_TOKEN=use-at-least-32-random-alphanumeric-characters
# MYAGENT_WORKSPACE_ROOTS=["C:/projects"]
# Docker é opcional; imagem padrão oven/bun:1.3.13, baixada na primeira execução aprovada.
# MYAGENT_SANDBOX_IMAGE=oven/bun:1.3.13
# MYAGENT_TEST_DOCKER_IMAGE=alpine:3
