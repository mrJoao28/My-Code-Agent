# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myagent

# Optional: Ollama local models
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Cloud model API keys are named from the model registry.
# Example:
# MYAGENT_ANTHROPIC_CLAUDE_OPUS_4_6_API_KEY=
# MYAGENT_OPENAI_GPT_5_4_API_KEY=
# MYAGENT_GOOGLE_GEMINI_3_PRO_API_KEY=
