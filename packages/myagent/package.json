  },
  "files": [
    "dist/cli.js",
    "dist/grep-worker.js",
    "dist/source-worker.js"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrJoao28/My-Code-Agent.git"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "coding-assistant",
    "bun"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "@prisma/adapter-libsql": "7.4.0",
    "@prisma/client": "7.4.0",
    "react": "19.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
